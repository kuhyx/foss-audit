# foss-audit as a systemd --user service: scanner API on 127.0.0.1:5191 and the
# production UI on 127.0.0.1:5190. Template; scripts/deploy.sh replaces @REPO@
# with the live checkout and installs it to ~/.config/systemd/user/.
[Unit]
Description=foss-audit (FOSS audit UI and scanner API)
After=network.target

[Service]
Type=simple
WorkingDirectory=@REPO@
# Serves dist/ as scripts/deploy.sh built it (stamped with the commit hash):
# building here would race the API's startup scan for CPU (>60 s). run.sh
# exits when either server dies, so systemd restarts both. A clean exit (0)
# only happens when run.sh found a fresh instance already serving.
ExecStart=@REPO@/run.sh --prebuilt --no-open
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
