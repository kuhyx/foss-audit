{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "target": "ES2023",
    // ESNext lib (not target) so Iterator Helpers (`.values().toArray()`) are
    // declared. They ship in Node 22+ and every 2024+ browser engine, which is
    // this project's floor; the emit target stays at ES2023.
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vitest/globals", "node"],

    /* Strictness beyond astro's "strictest" preset. */
    "useUnknownInCatchVariables": true,
    "erasableSyntaxOnly": true
  },
  "include": [".astro/types.d.ts", "src", "*.ts", "*.mjs"],
  // React leftovers stay on disk until each widget is ported (they are the
  // reference implementation); the build ignores them.
  "exclude": ["dist", "coverage", "**/*.tsx"]
}
