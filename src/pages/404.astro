---
/**
 * The real 404 page. A host serves it at whatever depth the missing path had,
 * so its links are absolute rather than relative.
 */
import Base from "../layouts/Base.astro";
import { absoluteUrl, SITE_NAME, SITE_URL } from "../lib/site/config.ts";
import { PAGES } from "../lib/site/content.ts";
import "../styles/doc.css";
---

<Base description="No page at this address." title={`Page not found · ${SITE_NAME}`}>
  <main class="doc">
    <h1><span aria-label="Page not found">🗄</span></h1>
    <p aria-label={`There is no page at this address on the ${SITE_NAME} site. These are the pages that exist:`} class="lead" role="img">
      ∅ → ↓
    </p>
    <!-- Page titles are the docs site's link names (AgentReady wants real text on a 404); the descriptions are spoken only. -->
    <ul>
      {
        PAGES.map((page) => {
          return (
            <li>
              <a aria-description={page.description} href={absoluteUrl(page.path, SITE_URL)}>{page.title}</a>
            </li>
          );
        })
      }
    </ul>
  </main>
</Base>
